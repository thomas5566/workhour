# Auto-detect other text files, then keep cross-platform source deterministic.
* text=auto

*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf

# Preserve native line endings for scripts normally launched by Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
