PROJECT_NAME=WorkHour API
PROJECT_VERSION=1.0.0
API_V1_STR=/api
DATABASE_URL=postgresql+psycopg2://workhour:change-me@db:5432/workhour
SECRET_KEY=replace-with-a-long-random-secret
DEVICE_CREDENTIAL_KEY=replace-with-a-fernet-key-and-keep-a-secure-backup
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MANAGER_ACCESS_TOKEN_EXPIRE_MINUTES=240
ENABLE_API_DOCS=true
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# Optional read-only infrastructure monitoring integrations.
ZABBIX_URL=
ZABBIX_TOKEN=
MONITORING_TIMEOUT_SECONDS=5
ALERT_LOG_POLL_SECONDS=60
