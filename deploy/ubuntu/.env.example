# Copy privately to .env on the VM, owned by root with mode 0600.
# Never generate replacement device encryption keys during a data migration.
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=
SECRET_KEY=
DEVICE_CREDENTIAL_KEY=
ZABBIX_URL=
ZABBIX_TOKEN=
WEB_PORT=8082
BIND_IP=
BACKEND_CORS_ORIGINS=
MONITORING_TIMEOUT_SECONDS=5
ALERT_LOG_POLL_SECONDS=60
# Initial deployment builds locally. CI/CD will supply immutable image references.
BACKEND_IMAGE=workhour-backend:local
FRONTEND_IMAGE=workhour-frontend:local
